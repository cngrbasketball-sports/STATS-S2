                    {id: "o30", jersey: 30, name: "SANTIAGO, MARLON", active: true},
                    {id: "o18", jersey: 18, name: "BERSAMINA, IAN", active: true},
                    {id: "o1", jersey: 1, name: "LACSAMANA, CECIL", active: true},
                    {id: "o14", jersey: 14, name: "BARBECHO JR., MELQUIADES", active: true},
                    {id: "o23", jersey: 23, name: "MALALUAN, GARY", active: true},
                    {id: "o22", jersey: 22, name: "BANDOJO, JEFFREY", active: true},
                    {id: "o7", jersey: 7, name: "ANTONIO, ALADDIN TITIYOKIMASH", active: true},
                    {id: "o2", jersey: 2, name: "AMARE, PAOLO SEMILLA", active: true},
                    {id: "o89", jersey: 89, name: "ORILLAZA, GHIO", active: true},
                    {id: "o4", jersey: 4, name: "VILLANUEVA, ARDIE", active: true},
                    {id: "o13", jersey: 13, name: "TRES, EMS SIBS (RSV)", active: true}
                ]
            }
        };

        const statsData = {};

        document.addEventListener("DOMContentLoaded", () => {
            populateSelects();
            renderRosterManagementViews();
            renderMatchup();
        });

        function populateSelects() {
            const homeSelect = document.getElementById("homeTeamSelect");
            const awaySelect = document.getElementById("awayTeamSelect");
            let keys = Object.keys(teamsData);

            keys.forEach(key => {
                homeSelect.innerHTML += `<option value="${key}">${teamsData[key].name}</option>`;
                awaySelect.innerHTML += `<option value="${key}">${teamsData[key].name}</option>`;
            });

            homeSelect.value = keys[0];
            awaySelect.value = keys[1];
        }

        function togglePlayerActive(teamKey, playerId) {
            let player = teamsData[teamKey].roster.find(p => p.id === playerId);
            if (player) {
                player.active = !player.active;
                renderRosterManagementViews();
                renderMatchup();
            }
        }

        function renderRosterManagementViews() {
            const container = document.getElementById("single-team-views");
            container.innerHTML = "";

            Object.keys(teamsData).forEach(teamKey => {
                const team = teamsData[teamKey];
                let rosterItemsHTML = "";

                team.roster.forEach(player => {
                    rosterItemsHTML += `
                        <div class="roster-item ${player.active ? '' : 'inactive'}">
                            <div>
                                <strong style="color:var(--accent-gold);">#${player.jersey}</strong> 
                                <span>${player.name}</span>
                            </div>
                            <label class="playing-toggle">
                                <input type="checkbox" ${player.active ? 'checked' : ''} onchange="togglePlayerActive('${teamKey}', '${player.id}')">
                                <span>${player.active ? 'PLAYING' : 'DNP'}</span>
                            </label>
                        </div>
                    `;
                });

                const viewDiv = document.createElement("div");
                viewDiv.id = `team-${teamKey}`;
                viewDiv.className = "view-panel";
                viewDiv.innerHTML = `
                    <div class="roster-card">
                        <div class="roster-header">
                            <div style="display:flex; align-items:center; gap:12px;">
                                <img src="${team.logo}" style="width:45px; height:45px; border-radius:50%; object-fit:cover; border:2px solid var(--accent-gold);">
                                <h2 style="color:var(--accent-gold);">${team.name} — GAME ROSTER</h2>
                            </div>
                            <span style="color:var(--text-muted); font-size:0.9rem;">Uncheck players who are not playing today</span>
                        </div>
                        <div class="roster-list">${rosterItemsHTML}</div>
                    </div>
                `;
                container.appendChild(viewDiv);
            });
        }

        function makeStepper(prefix, pId, statKey) {
            const key = `${prefix}_${pId}_${statKey}`;
            if (!(key in statsData)) statsData[key] = 0;

            return `
                <div class="stepper-unit">
                    <span class="stat-val" id="val_${key}">${statsData[key]}</span>
                    <div class="step-btns">
                        <button class="step-btn" onclick="stepStat('${prefix}', '${pId}', '${statKey}', 1)">▲</button>
                        <button class="step-btn dn" onclick="stepStat('${prefix}', '${pId}', '${statKey}', -1)">▼</button>
                    </div>
                </div>
            `;
        }

        function stepStat(prefix, pId, statKey, delta) {
            const key = `${prefix}_${pId}_${statKey}`;
            if (!(key in statsData)) statsData[key] = 0;
            statsData[key] = Math.max(0, statsData[key] + delta);

            if (delta > 0) {
                if (statKey.endsWith('m2')) stepStat(prefix, pId, statKey.replace('m2', 'a2'), 1);
                if (statKey.endsWith('m3')) stepStat(prefix, pId, statKey.replace('m3', 'a3'), 1);
                if (statKey.endsWith('m4')) stepStat(prefix, pId, statKey.replace('m4', 'a4'), 1);
                if (statKey.endsWith('ftm')) stepStat(prefix, pId, statKey.replace('ftm', 'fta'), 1);
            }

            const valEl = document.getElementById(`val_${key}`);
            if (valEl) valEl.textContent = statsData[key];
            updateRowAndTotals(prefix, pId);
        }

        function getStatVal(prefix, pId, statKey) {
            return statsData[`${prefix}_${pId}_${statKey}`] || 0;
        }

        function updateRowAndTotals(prefix, pId) {
            let m2 = 0, a2 = 0, m3 = 0, a3 = 0, m4 = 0, a4 = 0, ftm = 0, fta = 0;
            ['q1', 'q2', 'q3', 'q4'].forEach(q => {
                m2 += getStatVal(prefix, pId, `${q}_m2`);
                a2 += getStatVal(prefix, pId, `${q}_a2`);
                m3 += getStatVal(prefix, pId, `${q}_m3`);
                a3 += getStatVal(prefix, pId, `${q}_a3`);
                m4 += getStatVal(prefix, pId, `${q}_m4`);
                a4 += getStatVal(prefix, pId, `${q}_a4`);
                ftm += getStatVal(prefix, pId, `${q}_ftm`);
                fta += getStatVal(prefix, pId, `${q}_fta`);
            });

            const pts = (m2 * 2) + (m3 * 3) + (m4 * 4) + ftm;

            const ptsEl = document.getElementById(`pts_${prefix}_${pId}`);
            if (ptsEl) ptsEl.textContent = pts;

            calcTableTotals(prefix);
        }

        function buildStatTableHTML(teamKey, prefix) {
            const team = teamsData[teamKey];
            const activePlayers = team.roster.filter(p => p.active);
            let rowsHTML = "";

            if (activePlayers.length === 0) {
                rowsHTML = `<tr><td colspan="25" style="padding:20px; color:var(--text-muted);">No active players selected for today's game. Enable players in the team roster view.</td></tr>`;
            } else {
                activePlayers.forEach(player => {
                    const pId = player.id;
                    rowsHTML += `<tr id="row_${prefix}_${pId}">
                        <td><strong>${player.jersey}</strong></td>
                        <td class="player-col">${player.name}</td>`;

                    const quarters = ['Q1', 'Q2', 'Q3', 'Q4'];
                    quarters.forEach(q => {
                        const qLower = q.toLowerCase();
                        if (currentQuarterFilter === 'ALL' || currentQuarterFilter === q) {
                            rowsHTML += `
                                <td>${makeStepper(prefix, pId, `${qLower}_m2`)}</td><td>${makeStepper(prefix, pId, `${qLower}_a2`)}</td>
                                <td>${makeStepper(prefix, pId, `${qLower}_m3`)}</td><td>${makeStepper(prefix, pId, `${qLower}_a3`)}</td>
                                <td>${makeStepper(prefix, pId, `${qLower}_m4`)}</td><td>${makeStepper(prefix, pId, `${qLower}_a4`)}</td>
                                <td>${makeStepper(prefix, pId, `${qLower}_ftm`)}</td><td>${makeStepper(prefix, pId, `${qLower}_fta`)}</td>
                            `;
                        }
                    });

                    rowsHTML += `
                        <td>${makeStepper(prefix, pId, 'reb')}</td>
                        <td>${makeStepper(prefix, pId, 'ast')}</td>
                        <td>${makeStepper(prefix, pId, 'stl')}</td>
                        <td>${makeStepper(prefix, pId, 'blk')}</td>
                        <td>${makeStepper(prefix, pId, 'to')}</td>
                        <td>${makeStepper(prefix, pId, 'pf')}</td>
                        <td class="pts-cell" id="pts_${prefix}_${pId}">0</td>
                    </tr>`;
                });
            }

            return `
                <div class="team-header-banner">
                    <div class="team-info">
                        <img src="${team.logo}" class="team-header-logo" onerror="this.src='https://via.placeholder.com/45'">
                        <h2>${team.name}</h2>
                    </div>
                    <div class="team-score-badge" id="teamScore_${prefix}">0 PTS</div>
                </div>
                <div class="table-responsive">
                    <table class="stat-table" id="table_${prefix}">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th class="player-col">PLAYER</th>
                                ${getHeadersForFilter()}
                                <th>REB</th><th>AST</th><th>STL</th><th>BLK</th><th>TO</th><th>PF</th>
                                <th>PTS</th>
                            </tr>
                        </thead>
                        <tbody>${rowsHTML}</tbody>
                    </table>
                </div>
            `;
        }

        function buildPercentagesTableHTML(teamKey, prefix) {
            const team = teamsData[teamKey];
            const activePlayers = team.roster.filter(p => p.active);
            let rowsHTML = "";

            if (activePlayers.length === 0) {
                rowsHTML = `<tr><td colspan="17" style="padding:20px; color:var(--text-muted);">No active players selected for today's game.</td></tr>`;
            } else {
                activePlayers.forEach(player => {
                    const pId = player.id;
                    let m2 = 0, a2 = 0, m3 = 0, a3 = 0, m4 = 0, a4 = 0, ftm = 0, fta = 0;
                    ['q1', 'q2', 'q3', 'q4'].forEach(q => {
                        m2 += getStatVal(prefix, pId, `${q}_m2`);
                        a2 += getStatVal(prefix, pId, `${q}_a2`);
                        m3 += getStatVal(prefix, pId, `${q}_m3`);
                        a3 += getStatVal(prefix, pId, `${q}_a3`);
                        m4 += getStatVal(prefix, pId, `${q}_m4`);
                        a4 += getStatVal(prefix, pId, `${q}_a4`);
                        ftm += getStatVal(prefix, pId, `${q}_ftm`);
                        fta += getStatVal(prefix, pId, `${q}_fta`);
                    });

                    const pct2 = a2 > 0 ? Math.round((m2/a2)*100)+'%' : '0%';
                    const pct3 = a3 > 0 ? Math.round((m3/a3)*100)+'%' : '0%';
                    const pct4 = a4 > 0 ? Math.round((m4/a4)*100)+'%' : '0%';
                    const ftpct = fta > 0 ? Math.round((ftm/fta)*100)+'%' : '0%';
                    const pts = (m2 * 2) + (m3 * 3) + (m4 * 4) + ftm;

                    rowsHTML += `<tr>
                        <td><strong>${player.jersey}</strong></td>
                        <td class="player-col">${player.name}</td>
                        <td>${m2}/${a2}</td><td class="pct-cell">${pct2}</td>
                        <td>${m3}/${a3}</td><td class="pct-cell">${pct3}</td>
                        <td>${m4}/${a4}</td><td class="pct-cell">${pct4}</td>
                        <td>${ftm}/${fta}</td><td class="pct-cell">${ftpct}</td>
                        <td>${getStatVal(prefix, pId, 'reb')}</td>
                        <td>${getStatVal(prefix, pId, 'ast')}</td>
                        <td>${getStatVal(prefix, pId, 'stl')}</td>
                        <td>${getStatVal(prefix, pId, 'blk')}</td>
                        <td>${getStatVal(prefix, pId, 'to')}</td>
                        <td>${getStatVal(prefix, pId, 'pf')}</td>
                        <td class="pts-cell">${pts}</td>
                    </tr>`;
                });
            }

            return `
                <div class="team-header-banner">
                    <div class="team-info">
                        <img src="${team.logo}" class="team-header-logo" onerror="this.src='https://via.placeholder.com/45'">
                        <h2>${team.name} — OVERALL BOX SCORE</h2>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="stat-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th class="player-col">PLAYER</th>
                                <th>2PT (M/A)</th><th>2FG%</th>
                                <th>3PT (M/A)</th><th>3FG%</th>
                                <th>4PT (M/A)</th><th>4FG%</th>
                                <th>FT (M/A)</th><th>FT%</th>
                                <th>REB</th><th>AST</th><th>STL</th><th>BLK</th><th>TO</th><th>PF</th>
                                <th>PTS</th>
                            </tr>
                        </thead>
                        <tbody>${rowsHTML}</tbody>
                    </table>
                </div>
            `;
        }

        function getHeadersForFilter() {
            let h = "";
            const quarters = ['Q1', 'Q2', 'Q3', 'Q4'];

            quarters.forEach(q => {
                if (currentQuarterFilter === 'ALL' || currentQuarterFilter === q) {
                    h += `<th>${q} 2M</th><th>${q} 2A</th><th>${q} 3M</th><th>${q} 3A</th><th>${q} 4M</th><th>${q} 4A</th><th>${q} FTM</th><th>${q} FTA</th>`;
                }
            });
            return h;
        }

        function calcTableTotals(prefix) {
            const homeKey = document.getElementById("homeTeamSelect").value;
            const awayKey = document.getElementById("awayTeamSelect").value;
            const teamKey = prefix === 'home' ? homeKey : awayKey;
            const team = teamsData[teamKey];

            let totalPoints = 0;
            team.roster.filter(p => p.active).forEach(p => {
                let m2 = 0, m3 = 0, m4 = 0, ftm = 0;
                ['q1', 'q2', 'q3', 'q4'].forEach(q => {
                    m2 += getStatVal(prefix, p.id, `${q}_m2`);
                    m3 += getStatVal(prefix, p.id, `${q}_m3`);
                    m4 += getStatVal(prefix, p.id, `${q}_m4`);
                    ftm += getStatVal(prefix, p.id, `${q}_ftm`);
                });
                totalPoints += (m2 * 2) + (m3 * 3) + (m4 * 4) + ftm;
            });

            const scoreEl = document.getElementById(`teamScore_${prefix}`);
            if (scoreEl) scoreEl.textContent = `${totalPoints} PTS`;
        }

        function renderMatchup() {
            const homeKey = document.getElementById("homeTeamSelect").value;
            const awayKey = document.getElementById("awayTeamSelect").value;

            document.getElementById("homeMatchupContainer").innerHTML = buildStatTableHTML(homeKey, "home");
            document.getElementById("awayMatchupContainer").innerHTML = buildStatTableHTML(awayKey, "away");

            document.getElementById("homePercentagesContainer").innerHTML = buildPercentagesTableHTML(homeKey, "home");
            document.getElementById("awayPercentagesContainer").innerHTML = buildPercentagesTableHTML(awayKey, "away");

            teamsData[homeKey].roster.filter(p => p.active).forEach(p => updateRowAndTotals('home', p.id));
            teamsData[awayKey].roster.filter(p => p.active).forEach(p => updateRowAndTotals('away', p.id));
        }

        function setQuarterView(mode) {
            currentQuarterFilter = mode;
            document.querySelectorAll(".q-btn").forEach(b => b.classList.remove("active"));
            event.target.classList.add("active");
            renderMatchup();
        }

        function switchTab(tabId) {
            document.querySelectorAll(".view-panel").forEach(el => el.classList.remove("active"));
            document.querySelectorAll(".nav-btn").forEach(el => el.classList.remove("active"));

            document.getElementById(tabId).classList.add("active");
            event.currentTarget.classList.add("active");

            if (tabId === 'percentages-view') {
                renderMatchup();
            }
        }

        function exportCSV() {
            let csv = [];
            let activeView = document.querySelector(".view-panel.active");
            let tables = activeView.querySelectorAll("table.stat-table");

            tables.forEach(table => {
                let rows = table.querySelectorAll("tr");
                rows.forEach(row => {
                    let cols = row.querySelectorAll("th, td");
                    let rowData = [];
                    cols.forEach(col => {
                        let valSpan = col.querySelector(".stat-val");
                        if (valSpan) {
                            rowData.push(valSpan.textContent.trim());
                        } else {
                            rowData.push(`"${col.textContent.trim()}"`);
                        }
                    });
                    csv.push(rowData.join(","));
                });
                csv.push("");
            });

            let csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
            let downloadLink = document.createElement("a");
            downloadLink.download = `Congre_Basketball_Match_${new Date().toISOString().slice(0,10)}.csv`;
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.click();
        }
    </script>
