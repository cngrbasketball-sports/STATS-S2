                    {id: "d13", jersey: 13, name: "GAURANO, RG", active: true},
                    {id: "d42", jersey: 42, name: "GUMAPAC, ALVITTO", active: true},
                    {id: "d11", jersey: 11, name: "SISON, HIRNAN", active: true},
                    {id: "d18", jersey: 18, name: "TONGOL, BON", active: true},
